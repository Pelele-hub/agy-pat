{
  "manifest_version": 3,
  "name": "Quran Studio - Veo AI Video Bridge",
  "version": "2.0.0",
  "description": "Autonomous video generation bridge between Quran Video Studio (n8n) and Google Flow (Veo).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "*://storage.googleapis.com/*",
    "*://flow-content.google/*",
    "http://localhost:5056/*",
    "http://127.0.0.1:5056/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flow_headers",
        "enabled": true,
        "path": "rules/flow-headers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["flow_main_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Quran Studio Veo Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
